# Everything below is optional — all keys can be set (and changed) in the app's Settings page.
# Values saved in Settings take precedence over these.

# Server
PORT=4455
# Public endpoint (tracker, waitlist, hosted sites only — never the dashboard). Point a tunnel here.
PUBLIC_PORT=4456
HOST=127.0.0.1
# Extra host names allowed to reach the dashboard API (comma-separated), e.g. a LAN IP
ALLOWED_HOSTS=
# Set this if you expose the dashboard beyond localhost (HTTP basic auth, user "admin")
DASHBOARD_PASSWORD=

# AI backend (any OpenAI-compatible provider)
DEEPSEEK_API_KEY=
NIGHTSHIFT_LLM_BASE_URL=https://api.deepseek.com
NIGHTSHIFT_LLM_MODEL=deepseek-flash
