{
  "name": "nightshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted AI co-founder that builds and runs companies while you sleep.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "x-authorize": "tsx scripts/x-authorize.mts",
    "user": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/user.mts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test $(find server -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.1",
    "dompurify": "^3.4.15",
    "hono": "^4.13.7",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.24",
    "marked": "^18.0.12",
    "nodemailer": "^10.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
